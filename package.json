{
  "name": "paper-plane",
  "private": true,
  "version": "0.3.1",
  "description": "Telegram on Even G2 glasses: the chats you pick at a glance, answered by voice.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src && node scripts/architecture.mjs",
    "architecture": "node scripts/architecture.mjs --write",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint src && node scripts/architecture.mjs && tsc --noEmit && vitest run && vite build && node scripts/store-check.mjs dist && npm run build:telegram && node scripts/store-check.mjs dist-telegram",
    "build:telegram": "VITE_TELEGRAM_API_ID=1 VITE_TELEGRAM_API_HASH=check VITE_RELAY=https://paper-plane-relay.jarekbird.workers.dev vite build --outDir dist-telegram",
    "pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@fuman/net": "0.0.23",
    "@mtcute/core": "0.32.8",
    "@mtcute/web": "0.32.8",
    "earshot": "github:jarekbird/earshot#v0.0.63"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
